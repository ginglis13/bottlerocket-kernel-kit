From ff9be6a61892a464781571b4a24f19f439f330e8 Mon Sep 17 00:00:00 2001
From: Piyush Jena <jepiyush@amazon.com>
Date: Mon, 26 Oct 2026 09:55:49 +0000
Subject: [PATCH] Revert "selinux: fix incorrect execmem checks on overlayfs"

This reverts commit 3668aedc95f0d7cafee25dc7040be8dda2667fe8.
---
 security/selinux/hooks.c | 42 +++++++++++++++++-----------------------
 1 file changed, 18 insertions(+), 24 deletions(-)

diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 58332b6a396d2..6afd975e78113 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -3811,9 +3811,9 @@ static int selinux_file_ioctl_compat(struct file *file, unsigned int cmd,
 
 static int default_noexec __ro_after_init;
 
-static int __file_map_prot_check(const struct file *file, unsigned long prot,
-				 bool shared, bool mounter_check,
-				 bool bf_user_file)
+static int __file_map_prot_check(const struct cred *cred,
+				 const struct file *file, unsigned long prot,
+				 bool shared, bool bf_user_file)
 {
 	struct inode *inode = NULL;
 	bool prot_exec = prot & PROT_EXEC;
@@ -3826,10 +3826,10 @@ static int __file_map_prot_check(const struct file *file, unsigned long prot,
 			inode = file_inode(file);
 	}
 
-	if (!mounter_check && default_noexec && prot_exec &&
+	if (default_noexec && prot_exec &&
 	    (!file || IS_PRIVATE(inode) || (!shared && prot_write))) {
 		int rc;
-		u32 sid = current_sid();
+		u32 sid = cred_sid(cred);
 
 		/*
 		 * We are making executable an anonymous mapping or a private
@@ -3842,8 +3842,6 @@ static int __file_map_prot_check(const struct file *file, unsigned long prot,
 	}
 
 	if (file) {
-		const struct cred *cred = mounter_check ?
-				file->f_cred : current_cred();
 		/* "read" always possible, "write" only if shared */
 		u32 av = FILE__READ;
 		if (shared && prot_write)
@@ -3857,11 +3855,11 @@ static int __file_map_prot_check(const struct file *file, unsigned long prot,
 	return 0;
 }
 
-static inline int file_map_prot_check(const struct file *file,
-				      unsigned long prot, bool shared,
-				      bool mounter_check)
+static inline int file_map_prot_check(const struct cred *cred,
+				      const struct file *file,
+				      unsigned long prot, bool shared)
 {
-	return __file_map_prot_check(file, prot, shared, mounter_check, false);
+	return __file_map_prot_check(cred, file, prot, shared, false);
 }
 
 static int selinux_mmap_addr(unsigned long addr)
@@ -3877,14 +3875,12 @@ static int selinux_mmap_addr(unsigned long addr)
 	return rc;
 }
 
-static int selinux_mmap_file_common(struct file *file, unsigned long prot,
-				    bool shared, bool mounter_check)
+static int selinux_mmap_file_common(const struct cred *cred, struct file *file,
+				    unsigned long prot, bool shared)
 {
 	if (file) {
 		int rc;
 		struct common_audit_data ad;
-		const struct cred *cred = mounter_check ?
-				file->f_cred : current_cred();
 
 		ad.type = LSM_AUDIT_DATA_FILE;
 		ad.u.file = file;
@@ -3893,16 +3889,15 @@ static int selinux_mmap_file_common(struct file *file, unsigned long prot,
 			return rc;
 	}
 
-	return file_map_prot_check(file, prot, shared, mounter_check);
+	return file_map_prot_check(cred, file, prot, shared);
 }
 
 static int selinux_mmap_file(struct file *file,
 			     unsigned long reqprot __always_unused,
 			     unsigned long prot, unsigned long flags)
 {
-	return selinux_mmap_file_common(file, prot,
-					(flags & MAP_TYPE) == MAP_SHARED,
-					false);
+	return selinux_mmap_file_common(current_cred(), file, prot,
+					(flags & MAP_TYPE) == MAP_SHARED);
 }
 
 /**
@@ -3934,9 +3929,8 @@ static int selinux_mmap_backing_file(struct vm_area_struct *vma,
 	if (vma->vm_flags & VM_EXEC)
 		prot |= PROT_EXEC;
 
-	return selinux_mmap_file_common(backing_file, prot,
-					vma->vm_flags & VM_SHARED,
-					true);
+	return selinux_mmap_file_common(backing_file->f_cred, backing_file,
+					prot, vma->vm_flags & VM_SHARED);
 }
 
 static int selinux_file_mprotect(struct vm_area_struct *vma,
@@ -3997,11 +3991,11 @@ static int selinux_file_mprotect(struct vm_area_struct *vma,
 		}
 	}
 
-	rc = __file_map_prot_check(file, prot, shared, false, backing_file);
+	rc = __file_map_prot_check(cred, file, prot, shared, backing_file);
 	if (rc)
 		return rc;
 	if (backing_file) {
-		rc = file_map_prot_check(file, prot, shared, true);
+		rc = file_map_prot_check(file->f_cred, file, prot, shared);
 		if (rc)
 			return rc;
 	}
-- 
2.52.0

