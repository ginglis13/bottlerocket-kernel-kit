# Architecture-specific configurations for aarch64

# compress arm64 kernels
CONFIG_EFI_ZBOOT=y

# Disable unused filesystems on aarch64
# CONFIG_JFFS2_FS is not set

# No DMA CMA area. The AL2023 aarch64 base reserves a 64 MiB CMA region
# (CONFIG_CMA_SIZE_MBYTES=64) that only movable allocations may use. Every
# microvm guest device is virtio, so nothing allocates from it; near a tight
# guest memory limit the idle reservation just leaves the kernel short of pages
# for slab. x86_64 never had CMA here, so this only needs disabling on aarch64.
# CONFIG_DMA_CMA is not set
