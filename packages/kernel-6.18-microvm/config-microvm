# Kernel configuration overrides for the microvm flavor.
#
# This flavor targets Firecracker guests (the aws-dev-enclave variant), which
# have a fixed, minimal device model. Everything needed to reach userspace is
# built in, because Bottlerocket does not use an initramfs and nothing can be
# modprobed before the root filesystem is mounted.


# Firecracker exposes all virtio devices over MMIO, and Bottlerocket has no
# initramfs, so the transport and the root block device driver must be built in
# or the dm-verity root filesystem can never be found.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y

# Networking and vsock are the enclave's only channels to the host, so keep them
# built in rather than relying on module loading early in boot.
CONFIG_VIRTIO_NET=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VHOST=y
CONFIG_VHOST_IOTLB=y
CONFIG_VHOST_VSOCK=y

# The remaining options below are built in rather than modular for the same
# reason: the enclave should not depend on module loading at runtime. This set
# is taken from the kernel that previously shipped as kernel-6.18-microvm.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ASYNC_CORE=y
CONFIG_ASYNC_XOR=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_CRC16=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_XTS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DNS_RESOLVER=y
CONFIG_DUMMY=y
CONFIG_EEPROM_93CX6=y
CONFIG_EXT4_FS=y
CONFIG_FS_MBCACHE=y
CONFIG_GRACE_PERIOD=y
CONFIG_HID_GENERIC=y
CONFIG_HWMON=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_TUNNEL=y
CONFIG_INPUT_VIVALDIFMAP=y
CONFIG_IPV6_SIT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_JBD2=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_LLC=y
CONFIG_LOCKD=y
CONFIG_MOUSE_PS2=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NET_IP_TUNNEL=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_OVERLAY_FS=y
CONFIG_PNFS_BLOCK=y
CONFIG_PNFS_FILE_LAYOUT=y
CONFIG_PNFS_FLEXFILE_LAYOUT=y
CONFIG_RPCSEC_GSS_KRB5=y
CONFIG_SERIAL_8250_EXAR=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_SERIO_SERPORT=y
CONFIG_STP=y
CONFIG_SUNRPC=y
CONFIG_SUNRPC_GSS=y
CONFIG_VETH=y
CONFIG_XOR_BLOCKS=y

# Nitro Secure Module. The sandbox guest talks to the NSM device for
# attestation/entropy, so build the driver in rather than rely on module
# loading at runtime (there is no initramfs).
CONFIG_NSM=y

